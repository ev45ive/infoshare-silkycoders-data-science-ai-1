# Usługa BC-09: zmienne środowiskowe (kopiuj do .env, uzupełnij; .env NIE trafia do repozytorium)
BC09_STATE_HOST=127.0.0.1
BC09_STATE_PORT=5433
BC09_STATE_DB=retaildw_bc09_state
BC09_STATE_OWNER_PASSWORD=
BC09_STATE_SVC_PASSWORD=
BC09_JWT_SECRET=
BC09_TOKEN_TTL_MIN=60
# limity (domyślnie takie same dla każdego użytkownika; można nadpisać)
BC09_DAILY_TOKEN_LIMIT=200000
BC09_MAX_QUESTION_CHARS=1000
BC09_APPROVAL_TTL_HOURS=72
BC09_API_URL=http://127.0.0.1:8000
# model językowy (czytane przez rdzeń): OPENAI_API_KEY z zmiennej środowiskowej systemu, nie z pliku
# hasła użytkowników szkoleniowych (tylko środowisko szkoleniowe)
BC09_SEED_PW_ALA=
BC09_SEED_PW_BARTEK=
BC09_SEED_PW_CELINA=
# klient MCP / UI
BC09_API_TOKEN=
